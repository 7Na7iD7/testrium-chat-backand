# کپی کن به .env و مقادیر واقعی رو جایگزین کن — .env هرگز commit نشود.

# دیتابیس اختصاصی چت (کاملاً جدا از دیتابیس اصلی Supabase پروژه)
CHAT_DATABASE_URL=postgres://testrium_chat:CHANGE_ME@localhost:5432/testrium_chat

# از Supabase Dashboard → Settings → API → JWT Secret
SUPABASE_JWT_SECRET=CHANGE_ME

# از Supabase Dashboard → Settings → API → Project URL
SUPABASE_URL=https://xxxxx.supabase.co

# از Supabase Dashboard → Settings → API → service_role key
# (فعلاً مستقیم استفاده نمی‌شود؛ برای عملیات آینده نگه داشته شده)
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME

# یک رشته‌ی تصادفی طولانی که خودت می‌سازی، مثلاً با:
#   openssl rand -hex 32
# دقیقاً همین مقدار باید در Supabase به‌عنوان secret دو Edge Function
# chat-identity و chat-verify-link هم ست شود:
#   supabase secrets set CHAT_SERVER_SHARED_SECRET=<همین مقدار>
CHAT_SERVER_SHARED_SECRET=CHANGE_ME

CHAT_PORT=8080
CHAT_MAX_MESSAGE_LENGTH=4000

# آدرس سرور LiveKit (خودمیزبان یا LiveKit Cloud) و کلیدهای API آن
LIVEKIT_URL=https://your-livekit-host
LIVEKIT_API_KEY=CHANGE_ME
LIVEKIT_API_SECRET=CHANGE_ME

VOICE_TOKEN_TTL_SECONDS=21600
VOICE_MAX_PARTICIPANTS=50

# حداقل زمان حضور (ثانیه) برای این‌که یک نفر در گزارش حضور و غیاب
# «حاضر» محسوب شود
VOICE_ATTENDANCE_THRESHOLD_SECONDS=600

# اطلاعات S3-Compatible برای ذخیره‌ی ضبط جلسات صوتی — از
# Supabase Dashboard → Storage → S3 Access Keys ساخته می‌شود
EGRESS_S3_BUCKET=CHANGE_ME
EGRESS_S3_REGION=auto
EGRESS_S3_ENDPOINT=https://xxxxx.supabase.co/storage/v1/s3
EGRESS_S3_ACCESS_KEY=CHANGE_ME
EGRESS_S3_SECRET_KEY=CHANGE_ME
