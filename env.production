# ==== دیتابیس محلی چت (داخل Docker Compose - سرویس chat-db) ====
CHAT_DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
CHAT_DATABASE_URL=postgres://postgres:REPLACE_WITH_STRONG_PASSWORD@chat-db:5432/testrium_chat

# ==== اتصال به Supabase self-hosted (نه ابری!) ====
SUPABASE_URL=https://supabase.YOUR-UNIVERSITY-DOMAIN
SUPABASE_JWT_SECRET=REPLACE_WITH_SUPABASE_SERVER_JWT_SECRET
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_NEW_SERVICE_ROLE_KEY

# ==== Shared secret بین چت و Edge Functions (chat-identity / chat-verify-link) ====
CHAT_SERVER_SHARED_SECRET=REPLACE_WITH_openssl_rand_base64_32

# ==== تنظیمات عمومی چت ====
CHAT_PORT=9090
CHAT_MAX_MESSAGE_LENGTH=4000

# ==== LiveKit (گفتگوی صوتی گروهی کلاس‌ها) ====
# LIVEKIT_URL آدرس عمومی پشت nginx با TLS است (نه آدرس داخلی
# 127.0.0.1:7880). API_KEY/API_SECRET باید دقیقاً همان مقداری باشند
# که زیر کلید keys: در livekit.yaml ست شده‌اند.
LIVEKIT_URL=wss://voice.YOUR-UNIVERSITY-DOMAIN
LIVEKIT_API_KEY=REPLACE_WITH_API_KEY
LIVEKIT_API_SECRET=REPLACE_WITH_openssl_rand_base64_32

VOICE_TOKEN_TTL_SECONDS=21600
VOICE_MAX_PARTICIPANTS=50
VOICE_ATTENDANCE_THRESHOLD_SECONDS=600

# ==== ضبط جلسات صوتی (LiveKit Egress → Supabase Storage self-hosted) ====
# از پنل مدیریت Supabase self-hosted دانشگاه → Storage → S3 Access Keys
# ساخته می‌شود. چون Supabase self-hosted است، آدرس endpoint هم روی همان
# دامنه‌ی دانشگاه است، نه xxxxx.supabase.co.
EGRESS_S3_BUCKET=voice-recordings
EGRESS_S3_REGION=auto
EGRESS_S3_ENDPOINT=https://supabase.YOUR-UNIVERSITY-DOMAIN/storage/v1/s3
EGRESS_S3_ACCESS_KEY=REPLACE_WITH_S3_ACCESS_KEY
EGRESS_S3_SECRET_KEY=REPLACE_WITH_S3_SECRET_KEY
