{
  "title": "Testrium Chat Server",
  "uid": "testrium-chat",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "اتصالات فعال WebSocket",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "testrium_ws_active_connections",
          "legendFormat": "active connections",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "نرخ پیام در ثانیه",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum by (event_type) (rate(testrium_ws_messages_total[1m]))",
          "legendFormat": "{{event_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "رد شدن‌های Rate Limiter (۵ دقیقه)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum by (kind) (rate(testrium_rate_limit_rejections_total[5m]))",
          "legendFormat": "{{kind}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.1 },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "مسیر تشخیص هویت",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "targets": [
        {
          "expr": "sum by (path) (increase(testrium_identity_resolve_path_total[1h]))",
          "legendFormat": "{{path}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "اتاق‌های صوتی فعال",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "targets": [
        {
          "expr": "testrium_voice_active_rooms",
          "legendFormat": "active rooms",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "تأخیر درخواست‌های HTTP (p95/p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(axum_http_requests_duration_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(axum_http_requests_duration_seconds_bucket[5m])))",
          "legendFormat": "p99",
          "refId": "B"
        }
      ]
    },
    {
      "id": 7,
      "title": "کدهای خطای ۵xx",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(axum_http_requests_total{status=~\"5..\"}[5m]))",
          "legendFormat": "5xx rate",
          "refId": "A"
        }
      ],
      "alert": {
        "name": "5xx بالا",
        "conditions": [
          {
            "evaluator": { "type": "gt", "params": [0.05] },
            "operator": { "type": "and" },
            "query": { "params": ["A", "5m", "now"] },
            "reducer": { "type": "avg" },
            "type": "query"
          }
        ],
        "frequency": "1m",
        "for": "5m"
      }
    }
  ]
}
