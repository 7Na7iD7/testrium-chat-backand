# فایل .env سرویس چت (chat-infra) — نسخه‌ی اصلاح‌شده برای instance self-hosted
# مسیر مقصد: testrium-chat/.env (روی همون سروری که Rust chat-infra اجرا می‌شه)

# بدون تغییر — دیتابیس اختصاصی چت (کاملاً مستقل از Supabase)
CHAT_DATABASE_URL=postgres://postgres:devpass@localhost:5432/testrium_chat

# ⚠️ باید عوض بشه، و این دفعه اختیاری نیست — حیاتیه.
# نسخه‌ی self-hosted استاندارد GoTrue توکن‌های ورود واقعی رو با HS256
# امضا می‌کنه (نه ES256/JWKS مثل نسخه‌ی ابری قبلی). یعنی chat-infra
# دیگه نمی‌تونه از مسیر JWKS استفاده کنه و باید از همین مسیر
# legacy_jwt_secret (که در config.rs از قبل به‌عنوان fallback HS256
# آماده شده بود) به‌عنوان مسیر اصلیِ verify استفاده کنه.
# مقدار این متغیر باید دقیقاً همون JWT_SECRET باشه که در .env
# instance self-hosted (env/.env.template) گذاشتی — نه یک مقدار جدا.
SUPABASE_JWT_SECRET=REPLACE_WITH_SAME_JWT_SECRET_AS_SUPABASE_ENV

# ⚠️ باید عوض بشه: آدرس API instance self-hosted
# (همون که در app_constants.dart هم گذاشتی — باید دقیقاً یکی باشن)
SUPABASE_URL=https://supabase.YOUR-UNIVERSITY-DOMAIN

# ⚠️ باید عوض بشه: SERVICE_ROLE_KEY تولیدشده برای instance جدید
# (از scripts/00_generate_jwt_keys.py — همون خروجی SERVICE_ROLE_KEY)
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_NEW_SERVICE_ROLE_KEY

# بدون تغییر — این secret فقط بین chat-infra و دو Edge Function
# (chat-identity, chat-verify-link) رد و بدل می‌شه، ربطی به Supabase
# instance نداره. فقط مطمئن شو دقیقاً همین مقدار رو در .env instance
# self-hosted جدید هم (بخش Edge Functions) گذاشتی.
CHAT_SERVER_SHARED_SECRET=my-dev-secret-12345

# بدون تغییر
CHAT_PORT=9090
CHAT_MAX_MESSAGE_LENGTH=4000

# ⚠️ جدید — برای فیچر «اطلاع فوری تغییر دسترسی» (migration 0021 +
# sync-user-claims). این secret باید دقیقاً همون مقداری باشه که در
# .env instance self-hosted Supabase هم برای CHAT_SERVER_NOTIFY_SECRET
# گذاشتی — یک secret تازه و جدا از CHAT_SERVER_SHARED_SECRET بالا،
# چون این یکی مسیر برعکس رو محافظت می‌کنه (Supabase -> Rust، نه Rust -> Supabase).
# ⚠️ پیش‌نیاز: کد Rust باید یک endpoint به اسم /internal/notify-claims-updated
# داشته باشه که این secret رو چک کنه — اگه هنوز اضافه نشده، این فیچر
# کار نمی‌کنه (ولی بی‌خطره، سمت Supabase فقط لاگ warning می‌ده).
CHAT_SERVER_NOTIFY_SECRET=REPLACE_WITH_SAME_VALUE_AS_SUPABASE_ENV
